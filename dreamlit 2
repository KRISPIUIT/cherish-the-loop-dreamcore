<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Dreamlit 3D</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#080912;color:#ffeaff;font:14px 'Courier New',monospace;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:100vh;overflow:hidden}h1{margin:0 0 4px;letter-spacing:5px;text-shadow:0 0 14px #ff54b5}.sub{font-size:12px;color:#c9b9d9;margin-bottom:10px}#game{position:relative;width:min(95vw,900px);height:min(68vh,560px);min-height:360px;border:3px solid #ff9ed8;border-radius:10px;overflow:hidden;box-shadow:0 0 28px #ff5db555}canvas{width:100%;height:100%;display:block;background:#151525}#scan{position:absolute;inset:0;pointer-events:none;background:linear-gradient(transparent 50%,#0003 50%);background-size:100% 4px}#hud{width:min(95vw,900px);display:flex;justify-content:space-between;gap:10px;margin-top:9px;font-weight:bold;font-size:13px}.bar{display:inline-block;width:150px;height:14px;border:2px solid #ff9ed8;background:#000}.fill{display:block;width:100%;height:100%;background:linear-gradient(90deg,#ff9ed8,#ff4fae)}#help{color:#c9b9d9;text-align:center;font-size:12px;margin-top:8px}button{display:none;margin-top:10px;background:transparent;color:#fff;border:2px solid #ff9ed8;padding:8px 16px;font:700 14px 'Courier New';cursor:pointer}.modal{position:absolute;inset:0;background:#090914e8;display:none;align-items:center;justify-content:center;text-align:center;padding:20px}.box{max-width:460px;border:2px solid #ff9ed8;background:#171525;padding:25px;box-shadow:0 0 20px #ff5db566}.box h2{color:#ffb2de}.box button{display:inline-block;margin:8px 4px}</style>
</head>
<body><h1>DREAMLIT 3D</h1><div class="sub">SUPER ILLIT • EL SUEÑO DE COLORES</div>
<div id="game"><canvas id="view" width="900" height="560"></canvas><div id="scan"></div><div id="modal" class="modal"><div class="box"><h2 id="miniTitle"></h2><p id="miniText"></p><button id="a1"></button><button id="a2"></button></div></div></div>
<div id="hud"><span>CORDURA: <i class="bar"><i id="sanity" class="fill"></i></i></span><span id="keys">LLAVES: 0/5</span><span id="parts">PIEZAS: 0/5</span><span id="status">Despiertas en el sueño...</span></div><button id="restart">REINICIAR</button><div id="help">WASD/Flechas: moverte · E: interactuar/recoger · ESPACIO: luz · acerca las 5 piezas a la puerta</div>
<script>
const c=document.querySelector('#view'),x=c.getContext('2d'),W=c.width,H=c.height,ui={s:document.querySelector('#sanity'),k:document.querySelector('#keys'),p:document.querySelector('#parts'),t:document.querySelector('#status'),r:document.querySelector('#restart'),m:document.querySelector('#modal'),mt:document.querySelector('#miniTitle'),mx:document.querySelector('#miniText'),a1:document.querySelector('#a1'),a2:document.querySelector('#a2')};
let keys={},state='intro',last=0,pulse=0,mini=null,toast=0;
const P={x:90,y:450,r:13,spd:2.9,sanity:100,keys:0,parts:0};
const monster={x:790,y:90,r:25,spd:1.0};
const exit={x:835,y:450,w:42,h:65};
const walls=[{x:130,y:60,w:22,h:210},{x:270,y:100,w:220,h:22},{x:405,y:50,w:22,h:220},{x:180,y:330,w:235,h:22},{x:555,y:145,w:22,h:230},{x:650,y:90,w:190,h:22},{x:700,y:360,w:22,h:120},{x:470,y:460,w:210,h:22}];
const members=[{n:'YUNAH',x:190,y:145,key:false,saved:false,phrase:'¿Y Minju? La sigo esperando...'},{n:'WONHEE',x:590,y:245,key:false,saved:false,phrase:'¡Iroha! ¿Sigues con vida?'},{n:'MOKA',x:330,y:410,key:false,saved:false,phrase:'¡Ush, ya me cansé!'},{n:'MINJU',x:730,y:180,key:false,saved:false,phrase:'La la la... ♪'},{n:'IROHA',x:790,y:330,key:false,saved:false,phrase:'Las extraño, unnies...'}];
const pieces=[{x:100,y:100,c:'#ff5252',got:false},{x:520,y:75,c:'#ffd84d',got:false},{x:550,y:410,c:'#55c8ff',got:false},{x:250,y:285,c:'#77ffad',got:false},{x:640,y:315,c:'#c68aff',got:false}];
function clamp(v,a,b){return Math.max(a,Math.min(b,v))}function d(a,b,c,d){return Math.hypot(a-c,b-d)}function hit(a,b,r){return walls.some(w=>d(clamp(a,w.x,w.x+w.w),clamp(b,w.y,w.y+w.h),a,b)<r+2)}function msg(t){ui.t.textContent='ESTADO: '+t;toast=180}function say(n,t){msg(n+': '+t)}
function reset(){state='intro';mini=null;P.x=90;P.y=450;P.sanity=100;P.keys=0;P.parts=0;monster.x=790;monster.y=90;monster.spd=1;pieces.forEach(z=>z.got=false);members.forEach(z=>{z.key=false;z.saved=false});ui.s.style.width='100%';ui.k.textContent='LLAVES: 0/5';ui.p.textContent='PIEZAS: 0/5';msg('Despiertas en el sueño...');ui.r.style.display='none';ui.m.style.display='none'}
function begin(){if(state==='intro'){state='play';msg('encuentra una llave y ayuda a YUNAH')}}
function openMini(member){if(mini||member.key)return;mini=member;ui.m.style.display='flex';ui.mt.textContent='MINIJUEGO: '+member.n;ui.mx.textContent=member.n==='MINJU'?'Ayuda a Minju a despertar. Elige la secuencia correcta.':'Encuentra la frecuencia correcta para completar la llave.';ui.a1.textContent='Opción A';ui.a2.textContent='Opción B';ui.a1.onclick=()=>finishMini(true);ui.a2.onclick=()=>finishMini(false)}
function finishMini(ok){if(!mini)return;if(ok){mini.key=true;P.keys++;ui.k.textContent='LLAVES: '+P.keys+'/5';say(mini.n,mini.n==='MINJU'?'¡Desperté! No me dejes atrás.':'Toma la llave. ¡Corre!');ui.m.style.display='none';mini=null}else{say('SUEÑO','La respuesta no era esa...');P.sanity-=8}}
function interact(){for(const m of members)if(d(P.x,P.y,m.x,m.y)<38){if(!m.key)openMini(m);else if(!m.saved){m.saved=true;P.parts++;ui.p.textContent='PIEZAS: '+P.parts+'/5';say(m.n,m.n==='IROHA'?'Tengo la última pieza. Ahora debemos llegar a la puerta.':m.phrase);}}for(const q of pieces)if(!q.got&&d(P.x,P.y,q.x,q.y)<30){q.got=true;P.parts++;ui.p.textContent='PIEZAS: '+P.parts+'/5';msg('recoges una forma de color')}}
function move(){let a=0,b=0;if(keys.ArrowUp||keys.KeyW)b--;if(keys.ArrowDown||keys.KeyS)b++;if(keys.ArrowLeft||keys.KeyA)a--;if(keys.ArrowRight||keys.KeyD)a++;if(a||b){let l=Math.hypot(a,b),nx=clamp(P.x+a/l*P.spd,P.r,W-P.r),ny=clamp(P.y+b/l*P.spd,P.r,H-P.r);if(!hit(nx,P.y,P.r))P.x=nx;if(!hit(P.x,ny,P.r))P.y=ny}}
function updateMonster(){let dx=P.x-monster.x,dy=P.y-monster.y,q=Math.hypot(dx,dy)||1;monster.spd=P.parts>=3?1.8:1.25;if(q<330){monster.x+=dx/q*monster.spd;monster.y+=dy/q*monster.spd}else{monster.x+=Math.sin(Date.now()/700)*.25;monster.y+=Math.cos(Date.now()/800)*.25}monster.x=clamp(monster.x,monster.r,W-monster.r);monster.y=clamp(monster.y,monster.r,H-monster.r)}
function updateFollowers(){members.forEach((m,i)=>{if(!m.saved)return;let target=i===0?P:{x:members[i-1].x,y:members[i-1].y};let dx=target.x-m.x,dy=target.y-m.y,q=Math.hypot(dx,dy)||1;if(q>38){m.x+=dx/q*1.7;m.y+=dy/q*1.7}})}
function update(){if(state==='intro'){if(keys.Enter)begin();return}if(state!=='play')return;move();if(keys.KeyE)interact();if(keys.Space&&!pulse)pulse=1;if(pulse){pulse+=5;let dx=monster.x-P.x,dy=monster.y-P.y,q=Math.hypot(dx,dy)||1;if(q<pulse+monster.r){monster.x+=dx/q*70;monster.y+=dy/q*70}if(pulse>90)pulse=0}updateMonster();updateFollowers();let near=d(P.x,P.y,monster.x,monster.y)<105;if(near)P.sanity-=.42;P.sanity=clamp(P.sanity,0,100);ui.s.style.width=P.sanity+'%';if(P.sanity<=0||d(P.x,P.y,monster.x,monster.y)<35){state='lose';msg('el animal te encontró');ui.r.style.display='inline-block'}if(P.keys===5&&P.parts===5&&members.every(m=>m.saved)&&d(P.x,P.y,exit.x+20,exit.y+30)<40){state='win';msg('¡abres la puerta y despiertas!');ui.r.style.display='inline-block'}}
function draw3D(){x.fillStyle='#090b18';x.fillRect(0,0,W,H);let grad=x.createLinearGradient(0,0,0,H);grad.addColorStop(0,'#151b3b');grad.addColorStop(.48,'#30234c');grad.addColorStop(.5,'#181326');grad.addColorStop(1,'#080a12');x.fillStyle=grad;x.fillRect(0,0,W,H);for(let i=1;i<9;i++){x.strokeStyle=`rgba(255,158,216,${.16-i*.01})`;x.beginPath();x.moveTo(W/2-450/i,H/2);x.lineTo(W/2-450/(i+1),H/2+(H/2)/(i));x.moveTo(W/2+450/i,H/2);x.lineTo(W/2+450/(i+1),H/2+(H/2)/(i));x.stroke()}for(let i=1;i<8;i++){let y=H/2+(H/2)*(i/8);x.strokeStyle='#44335c';x.beginPath();x.moveTo(0,y);x.lineTo(W,y);x.stroke()}const scale=Math.max(.2,1-d(P.x,P.y,monster.x,monster.y)/550);function sprite(o,color,label){let sx=W/2+(o.x-P.x)*1.15,sy=H/2+(o.y-P.y)*.7,sz=clamp(45*scale,18,65);if(sx<-80||sx>W+80||sy<-80||sy>H+80)return;x.fillStyle=color;x.shadowBlur=15;x.shadowColor=color;x.beginPath();x.arc(sx,sy,sz,0,7);x.fill();x.shadowBlur=0;x.fillStyle='#fff';x.font='11px Courier New';x.textAlign='center';x.fillText(label,sx,sy+sz+16)}pieces.forEach(q=>{if(!q.got)sprite(q,q.c,'FORMA')});members.forEach(m=>{if(!m.saved)sprite(m,m.n==='IROHA'?'#c68aff':'#f1e4ff',m.n)});sprite(monster,'#ff478e','');let msx=W/2+(monster.x-P.x)*1.15,msy=H/2+(monster.y-P.y)*.7,mr=clamp(60*scale,24,85);x.fillStyle='#ffb3df';x.beginPath();x.moveTo(msx-mr*.4,msy-mr*.7);x.lineTo(msx-mr*.7,msy-mr*1.45);x.lineTo(msx-mr*.1,msy-mr*.75);x.closePath();x.fill();x.beginPath();x.moveTo(msx+mr*.4,msy-mr*.7);x.lineTo(msx+mr*.7,msy-mr*1.45);x.lineTo(msx+mr*.1,msy-mr*.75);x.closePath();x.fill();x.fillStyle='#fff';x.beginPath();x.arc(msx-12,msy-5,5,0,7);x.arc(msx+12,msy-5,5,0,7);x.fill();x.fillStyle='#111';x.fillRect(msx-13,msy-6,3,3);x.fillRect(msx+11,msy-6,3,3);let ex=W/2+(exit.x-P.x)*1.15,ey=H/2+(exit.y-P.y)*.7;x.fillStyle=P.keys===5&&P.parts===5&&members.every(m=>m.saved)?'#9fffe0':'#382b4a';x.fillRect(ex-20,ey-35,40,70);x.strokeStyle='#ff9ed8';x.strokeRect(ex-20,ey-35,40,70);x.fillStyle='#fff';x.font='11px Courier New';x.fillText('PUERTA',ex,ey+5);if(pulse){x.strokeStyle='#ff9ed8';x.lineWidth=3;x.beginPath();x.arc(W/2,H/2,pulse,0,7);x.stroke()}}
function drawOverlay(){if(state==='intro'||state==='win'||state==='lose'){x.fillStyle='#050611cc';x.fillRect(0,0,W,H);x.fillStyle=state==='lose'?'#ff5774':'#f8eaff';x.font='bold 30px Courier New';x.textAlign='center';x.fillText(state==='intro'?'DREAMLIT':state==='win'?'¡DESPIERTAS Y LAS SALVAS!':'EL SUEÑO TE DEVORÓ',W/2,170);x.font='17px Courier New';if(state==='intro'){x.fillText('Encuentra las 5 llaves, completa los minijuegos y libera a las miembros.',W/2,230);x.fillText('Después reúne las piezas y llega a la puerta de salida.',W/2,265);x.fillText('Pulsa ENTER para comenzar',W/2,330)}if(state==='win'){x.fillText('Las cinco están frente a ti. Juntos reabriréis SUPER ILLIT.',W/2,235)}}}
function frame(t){update();draw3D();drawOverlay();requestAnimationFrame(frame)}
addEventListener('keydown',e=>{keys[e.code]=true;if(e.code==='Space')e.preventDefault()});addEventListener('keyup',e=>keys[e.code]=false);ui.r.onclick=reset;reset();requestAnimationFrame(frame);
</script></body></html>
